# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file (it is listed in .gitignore).

# Required. Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Optional: Gemini model code. See https://ai.google.dev/gemini-api/docs/models
# Default if left empty: gemini-3.5-flash-lite
# Another stable option: gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: 0 to 2. Leave empty to use the model's own default.
GEMINI_TEMPERATURE=

# Optional: how many recent messages are sent to the model (default 20).
MAX_HISTORY_MESSAGES=20

# Optional: change the assistant's personality/instructions.
SYSTEM_PROMPT=

# Optional Task 3 agent integration (off by default; see README).
ENABLE_TASK3_AGENT=false
TASK3_AGENT_DIR=../Task-3-Multi-Tool-AI-Agent
TASK3_AGENT_MODULE=agent
TASK3_AGENT_FUNCTION=run_agent
