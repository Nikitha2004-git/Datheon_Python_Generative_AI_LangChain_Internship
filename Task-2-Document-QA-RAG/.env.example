# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" to Git. Never share your real key.

# Your Gemini API key from https://aistudio.google.com/apikey  (required for answers)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used to write answers. Check current names at
# https://ai.google.dev/gemini-api/docs/models  (names change over time)
GEMINI_MODEL=gemini-3.5-flash-lite

# Local embedding model (runs on your CPU; downloaded once on first use)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Size of each text chunk in characters, and how much neighbouring chunks overlap
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# How many chunks to retrieve for each question
TOP_K=4

# Largest file you can upload, in megabytes
MAX_FILE_SIZE_MB=10

# Folder (inside the project) where the local vector database is stored
CHROMA_DIR=chroma_db
